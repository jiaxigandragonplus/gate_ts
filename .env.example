# ---- identity -----------------------------------------------------------
# Must be unique per gate process. Defaults to <hostname>-<port>.
GATE_ID=gate-1
# Address other nodes / clients use to reach this gate (host:port).
ADVERTISE_ADDR=127.0.0.1:7000
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=1

# ---- client listener ----------------------------------------------------
WS_HOST=0.0.0.0
WS_PORT=7000
WS_PATH=/ws
WS_MAX_PAYLOAD=65536
WS_PING_INTERVAL_MS=15000
WS_PONG_TIMEOUT_MS=45000
WS_AUTH_TIMEOUT_MS=10000
WS_MAX_BACKPRESSURE=4194304
WS_PERMESSAGE_DEFLATE=false
WS_MAX_CONNECTIONS=0
# Enable only when the gate sits behind your own load balancer.
WS_TRUST_PROXY=false
# Wire formats served to clients. A client picks one with the WebSocket
# subprotocol (gate.json.v1 / gate.pb.v1) or ?codec=json|pb.
WS_CODECS=json,protobuf
# Used when the client expresses no preference.
WS_DEFAULT_CODEC=json

# ---- jwt (issued by the login service, verified here) -------------------
JWT_SECRET=dev-secret-change-me
# For asymmetric signing use these instead of JWT_SECRET:
# JWT_PUBLIC_KEY_FILE=./keys/jwt-public.pem
# JWT_ALGORITHMS=RS256
# JWT_ISSUER=auth.example.com
# JWT_AUDIENCE=game-client
JWT_UID_CLAIM=sub
JWT_CLOCK_TOLERANCE_SEC=5

# ---- sessions -----------------------------------------------------------
# How long a dropped client may resume its session.
SESSION_RESUME_WINDOW_MS=60000
# Downstream packets retained per session for replay after a reconnect.
SESSION_REPLAY_BUFFER=256
SESSION_REGISTRY_TTL_MS=90000
SESSION_REGISTRY_REFRESH_MS=30000
# Allow resuming on a different gate (required behind an L4 balancer).
SESSION_CROSS_GATE_RESUME=true

# ---- limits -------------------------------------------------------------
LIMIT_MSGS_PER_SEC=30
LIMIT_BURST=60

# ---- redis --------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=gate

# ---- cluster ------------------------------------------------------------
CLUSTER_HEARTBEAT_MS=5000
CLUSTER_NODE_TTL_MS=15000
CLUSTER_NOTIFY_SESSION_EVENTS=true

# Which transport carries server-to-server messages: nats (recommended) or
# redis (pub/sub, no extra infrastructure). Redis holds cluster state either
# way. Every gate and every backend service MUST agree on this value - a
# mismatched node is excluded and logged rather than silently unreachable.
CLUSTER_TRANSPORT=nats

# ---- nats (used when CLUSTER_TRANSPORT=nats) ----------------------------
NATS_SERVERS=nats://127.0.0.1:4222
# Root of the subject hierarchy: <prefix>.node.<gateId>, <prefix>.broadcast,
# <prefix>.svc.<service>.<nodeId>. Must not contain "." "*" ">" or spaces.
NATS_SUBJECT_PREFIX=gate
# Auth: pick one. Leave all empty for an unauthenticated internal server.
# NATS_TOKEN=
# NATS_USER=
# NATS_PASS=
# NATS_CREDS_FILE=./nats.creds
NATS_TLS=false
# -1 keeps retrying forever, which is what a server node should do.
NATS_MAX_RECONNECT=-1
NATS_RECONNECT_WAIT_MS=250
NATS_PING_INTERVAL_MS=20000
NATS_REQUEST_TIMEOUT_MS=5000

# ---- backend services ---------------------------------------------------
BACKEND_REQUEST_TIMEOUT_MS=8000
BACKEND_STICKY_TTL_MS=300000
# Routing: inline JSON, or a file via ROUTES_FILE (see routes.example.json).
# ROUTES_FILE=./routes.example.json
# DEFAULT_SERVICE=game

# ---- admin / metrics ----------------------------------------------------
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000
# Required by POST /admin/* when set.
ADMIN_TOKEN=

SHUTDOWN_GRACE_MS=10000

# =========================================================================
# game node (src/game/main.ts) - the business-logic node
# =========================================================================
# Service name clients route to; must match the gate's route table.
GAME_SERVICE=game
# Must be unique per process. Defaults to <service>-<hostname>-<pid>.
# GAME_NODE_ID=game-1
GAME_ADMIN_HOST=127.0.0.1
GAME_ADMIN_PORT=9000

# Where player state is persisted: redis (JSON per player) or memory (tests).
# A real project injects its own PlayerStore - see src/game/store.ts.
GAME_STORE=redis

# How long a player stays in memory after going offline. Keep it >= the
# gate's SESSION_RESUME_WINDOW_MS so a reconnecting player finds state warm.
GAME_UNLOAD_DELAY_MS=90000
# Periodic flush of players with unsaved changes.
GAME_SAVE_INTERVAL_MS=30000
# Max queued messages per player; beyond this the client gets RateLimited
# instead of the queue growing without bound.
GAME_MAILBOX_LIMIT=64
# Warn when a single handler holds one player's mailbox this long.
GAME_SLOW_HANDLER_MS=200
# Ownership lease TTL; refreshed while the player is loaded.
GAME_LEASE_TTL_MS=60000
# System tick interval; 0 disables ticking.
GAME_TICK_INTERVAL_MS=1000
