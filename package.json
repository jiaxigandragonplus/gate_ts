{
  "name": "gate-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Horizontally scalable WebSocket gateway (gate) server for game backends",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock:game": "tsx tools/mockBackend.ts --service game",
    "mock:chat": "tsx tools/mockBackend.ts --service chat",
    "client": "tsx tools/testClient.ts",
    "token": "tsx tools/genToken.ts",
    "start:mock:game": "node dist/tools/mockBackend.js --service game",
    "start:mock:chat": "node dist/tools/mockBackend.js --service chat",
    "load": "tsx tools/loadTest.ts",
    "proto:gen": "tsx tools/genProto.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@nats-io/transport-node": "^3.4.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "protobufjs": "^7.6.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.0",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
